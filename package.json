{
  "name": "citymeter-restaurants",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "CityMETER · Restaurants — subdistrict-first 3D map of restaurant density, food types and price levels from the public CityMETER Restaurants overlay",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build:boundaries": "python3 -I scripts/build-boundaries.py --help",
    "build:data": "python3 -I scripts/build-data.py --help",
    "handoff:manifest": "node scripts/build-handoff.mjs",
    "handoff:bundle": "node scripts/build-handoff.mjs --zip dist/CityMETER-Restaurants-Developer-Handoff.zip",
    "verify:live": "node scripts/verify-live.mjs",
    "build:chains": "python3 -I scripts/build-chains.py --help",
    "build:land": "python3 -I scripts/build-land.py --help"
  }
}
