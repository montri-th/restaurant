{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityMETER Restaurants developer contracts",
  "description": "Shared envelope for product-statement.json, product-brief.json, implementation-plan.json and handoff-manifest.json. Carried over from CityMETER Luxury Brands (schema 1.3.0) with the product id changed; 1.4.0 adds the coverage, metric and categorical-cue contracts that a density product needs (product brief).",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "productId"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ],
      "description": "1.4.0 adds coverageContract, metricContract and categoricalCueContract to the product brief; 1.5.0 adds registerContract, landJoinContract and lodContract (release 0.3)"
    },
    "documentType": {
      "enum": [
        "product-statement",
        "product-brief",
        "implementation-plan",
        "handoff-manifest"
      ]
    },
    "productId": {
      "const": "citymeter-restaurants"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-statement"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "dataset_id",
          "positioning",
          "users",
          "problem",
          "competitor_landscape",
          "winning_strategy",
          "data_transparency",
          "known_limitations",
          "hypotheses_to_validate"
        ],
        "properties": {
          "positioning": {
            "type": "object",
            "required": [
              "one_line_highlight",
              "unique_advantage",
              "unique_vs_competitors"
            ]
          },
          "users": {
            "type": "object",
            "required": [
              "primary_users",
              "functional_needs",
              "emotional_needs",
              "trigger_voice_in_head",
              "value_proposition"
            ]
          },
          "problem": {
            "type": "object",
            "required": [
              "statement",
              "urgency",
              "severity"
            ]
          },
          "competitor_landscape": {
            "type": "object",
            "required": [
              "present_competitors",
              "aspirational_competitors",
              "expected_quality_bar"
            ],
            "properties": {
              "present_competitors": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "how_users_use_it",
                    "strength",
                    "gap"
                  ]
                }
              }
            }
          },
          "winning_strategy": {
            "type": "array",
            "minItems": 3
          },
          "hypotheses_to_validate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "hypothesis",
                "test",
                "criterion"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-brief"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "firstAha",
          "data",
          "visualSystem",
          "invariants",
          "chartContracts",
          "rowScopes",
          "mapFocusContract",
          "panel"
        ],
        "properties": {
          "firstAha": {
            "type": "object",
            "required": [
              "scope",
              "ranking",
              "numerator",
              "denominator",
              "action",
              "model",
              "filter",
              "defaultSnapshot",
              "fallbacks"
            ]
          },
          "rowScopes": {
            "type": "object",
            "required": [
              "scopeRows",
              "baseRows",
              "rows"
            ]
          },
          "mapFocusContract": {
            "type": "object",
            "required": [
              "principle",
              "states",
              "choropleth"
            ]
          },
          "panel": {
            "type": "object",
            "required": [
              "modes",
              "actions",
              "models"
            ]
          },
          "invariants": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "required": [
                "id",
                "rule"
              ]
            }
          },
          "chartContracts": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "viewKey",
                "title",
                "question",
                "encoding",
                "metric",
                "scope"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "implementation-plan"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "architecture",
          "selection",
          "tasks",
          "acceptanceCriteria",
          "developerWorkflow",
          "backlog"
        ],
        "properties": {
          "architecture": {
            "type": "object",
            "required": [
              "runtime",
              "commands",
              "libraries",
              "modules"
            ]
          },
          "selection": {
            "type": "object",
            "required": [
              "filterFields",
              "queryFields",
              "rowScopes",
              "panelActions"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "dependsOn",
                "acceptanceCriteria",
                "files",
                "status"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 14,
            "items": {
              "type": "object",
              "required": [
                "id",
                "scenario",
                "expected",
                "verificationType"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "handoff-manifest"
          }
        }
      },
      "then": {
        "required": [
          "generatedOn",
          "sourceCommit",
          "hashAlgorithm",
          "fileCount",
          "files"
        ],
        "properties": {
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "hashAlgorithm": {
            "const": "SHA-256"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-brief"
          },
          "schemaVersion": {
            "enum": [
              "1.3.0",
              "1.4.0"
            ]
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "cameraContract",
          "basemapContract",
          "massingContract",
          "breadcrumbContract",
          "venueXrayContract",
          "provinceContract",
          "pictogramContract"
        ],
        "properties": {
          "cameraContract": {
            "type": "object",
            "required": [
              "presets",
              "fitting"
            ]
          },
          "basemapContract": {
            "type": "object",
            "required": [
              "generator",
              "tiles",
              "palette"
            ]
          },
          "massingContract": {
            "type": "object",
            "required": [
              "cityTier",
              "focusTier",
              "hostTier",
              "rounding",
              "enclosure"
            ]
          },
          "breadcrumbContract": {
            "type": "object",
            "required": [
              "levels",
              "productionPath",
              "demoQuery",
              "provinceCodes"
            ]
          },
          "venueXrayContract": {
            "type": "object"
          },
          "provinceContract": {
            "type": "object"
          },
          "pictogramContract": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-brief"
          },
          "schemaVersion": {
            "const": "1.4.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "coverageContract",
          "metricContract",
          "categoricalCueContract"
        ],
        "properties": {
          "coverageContract": {
            "type": "object",
            "required": [
              "covered",
              "states"
            ]
          },
          "metricContract": {
            "type": "object",
            "required": [
              "areas",
              "provinces",
              "eligibility",
              "combined"
            ]
          },
          "categoricalCueContract": {
            "type": "object",
            "required": [
              "registry",
              "bindBy",
              "groups"
            ]
          }
        }
      }
    }
  ]
}
